# Local Docker Environment Variables

# Database Connection (Postgres in Docker)
# When running app from host (pnpm dev):
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# When running app inside Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# Authentication (Clerk - ADR-0012)
# Provide your Clerk test keys from dashboard.clerk.com for auth flows
CLERK_SECRET_KEY=sk_test_placeholder_for_local_development
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_for_local_development
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Governor Email auto-grant list (consulted at Student record onboarding)
GOVERNOR_EMAILS=governor@gbox.ncf.edu.ph

# Google Gemini AI API key (optional for report narratives)
GEMINI_API_KEY=

# Expo Mobile API Base URL
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

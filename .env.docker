# Governor Email auto-grant list (consulted at Student record onboarding)
GOVERNOR_EMAILS=governor@gbox.ncf.edu.ph

# Non-school emails let through onboarding's domain check for local testing
# without a second GBox account. Each also needs a matching allowlist
# exception in Clerk's dashboard (Configure > Restrictions) and a roster row
# (pnpm db:seed-test-emails:local) so it auto-claims on first /onboarding visit.
ONBOARDING_TEST_EMAILS=your-personal@gmail.com

# Google Gemini AI API key (optional for report narratives)
GEMINI_API_KEY=

# Expo Mobile API Base URL — a phone in Expo Go can't reach "127.0.0.1" as
# this machine, so use this machine's LAN IP instead (e.g. http://192.168.1.6:3000).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

{
  "name": "@attendance/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:integration": "bash scripts/test-integration.sh",
    "test:integration:run": "vitest run tests/integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=../../.env scripts/seed-students.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for Drizzle migrations (Settings > Database > Connection string, "Transaction" pooler)
DATABASE_URL=

# Base URL the magic-link email redirects back to (http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=

# Resend (resend.com/api-keys) — sends the post-verification confirmation email
# with the QR attached. Separate from the SMTP creds wired into Supabase Auth.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Comma-separated school emails auto-granted the governor role on their first
# magic-link verification. There is no in-app way to create a Governor.
GOVERNOR_EMAILS=

# Expo (apps/mobile) — same Supabase project, and the deployed apps/web URL
# the booth app calls for /api/events/mine, /api/scan/approve, /api/scan/reject
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=

# Google Gemini AI API key for report narrative generation
GEMINI_API_KEY=

# Clerk (dashboard.clerk.com > API keys). Google is the only sign-in method;
# the @gbox.ncf.edu.ph allowlist lives in Clerk's sign-up restrictions.
# The publishable key is the same value for web and mobile — one Clerk
# instance, two frontends — but each framework reads its own prefixed name.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The app hosts Clerk's sign-in component itself; this points Clerk's own
# redirects at that route instead of a vendor-hosted page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in


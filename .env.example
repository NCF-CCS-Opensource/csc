# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for Drizzle migrations (Settings > Database > Connection string, "Transaction" pooler)
DATABASE_URL=

# Base URL the magic-link email redirects back to (http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=

# Resend (resend.com/api-keys) — sends the post-verification confirmation email
# with the QR attached. Separate from the SMTP creds wired into Supabase Auth.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Comma-separated school emails auto-granted the governor role on their first
# magic-link verification. There is no in-app way to create a Governor.
GOVERNOR_EMAILS=

# Expo (apps/mobile) — same Supabase project, and the deployed apps/web URL
# the booth app calls for /api/events/mine, /api/scan/approve, /api/scan/reject
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=

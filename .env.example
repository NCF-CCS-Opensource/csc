# Postgres connection for Drizzle migrations (Settings > Database > Connection string, "Transaction" pooler)
# Local Supabase Docker: postgresql://postgres:postgres@localhost:54322/postgres
# Docker Compose internal: postgresql://postgres:postgres@db:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# Comma-separated school emails auto-granted the governor role when their
# Student record is created at onboarding. No in-app way to create a Governor.
GOVERNOR_EMAILS=jinfante@gbox.ncf.edu.ph

# Non-school emails let through onboarding's domain check for local testing
# without a second GBox account. Each also needs a matching allowlist
# exception in Clerk's dashboard (Configure > Restrictions) and a roster row
# (pnpm db:seed-test-emails:local) so it auto-claims on first /onboarding visit.
ONBOARDING_TEST_EMAILS=your-personal@gmail.com

# Expo (apps/mobile) — the deployed apps/web URL the booth app calls for
# /api/events/mine, /api/scan/approve, /api/scan/reject. The booth authenticates
# these with a Clerk session token (see EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY below),
# not a Supabase key. A phone running Expo Go can't reach "localhost" as
# itself — use this machine's LAN IP (e.g. http://192.168.1.6:3000).
EXPO_PUBLIC_API_BASE_URL=localhost:3000

# Google Gemini AI API key for report narrative generation
GEMINI_API_KEY=

# Clerk (dashboard.clerk.com > API keys). Google is the only sign-in method;
# the @gbox.ncf.edu.ph allowlist lives in Clerk's sign-up restrictions.
# The publishable key is the same value for web and mobile — one Clerk
# instance, two frontends — but each framework reads its own prefixed name.
CLERK_SECRET_KEY=sk_test_do7J1PMIuCZ8OkccDrbFeJ3ScUpyFBhij8zhsSh4GY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c2luY2VyZS11bmljb3JuLTk1NTAuY2xlcmsuYWNjb3VudHMuZGV2JA
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c2luY2VyZS11bmljb3JuLTk1NTAuY2xlcmsuYWNjb3VudHMuZGV2JA
# The app hosts Clerk's sign-in component itself; this points Clerk's own
# redirects at that route instead of a vendor-hosted page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in


# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for Drizzle migrations (Settings > Database > Connection string, "Transaction" pooler)
DATABASE_URL=

# Expo (apps/mobile) reads the NEXT_PUBLIC_-free equivalents via app.config.ts
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
